{
  "name": "blizzless-runewords",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint . && stylelint \"src/**/*.{vue,scss,css}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{vue,scss,css}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,js,json,scss,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue,js,json,scss,css}\"",
    "stylelint": "stylelint \"src/**/*.{vue,scss,css}\"",
    "stylelint:fix": "stylelint \"src/**/*.{vue,scss,css}\" --fix",
    "test": "node scripts/check-catalog.mjs && node scripts/check-cube.mjs && node scripts/check-planner.mjs && node scripts/check-planner-damage.mjs && node scripts/check-planner-items.mjs && node scripts/check-planner-affixes.mjs && node scripts/check-planner-game-save-mode.mjs && node scripts/check-planner-game-save.mjs && node scripts/check-planner-sockets.mjs && node scripts/check-planner-waypoints.mjs",
    "sync:planner": "node scripts/sync-planner.mjs && prettier --write src/shared/planner-catalog.json src/shared/planner-runewords.json",
    "test:planner-damage": "node scripts/check-planner-damage.mjs",
    "sync:planner-combat": "node scripts/sync-planner-combat.mjs && prettier --write src/shared/planner-combat.json",
    "sync:planner-save": "node scripts/sync-planner-save.mjs",
    "sync:planner-sockets": "node scripts/sync-planner-sockets.mjs && prettier --write src/shared/planner-sockets.json",
    "sync:planner-items": "node scripts/sync-planner-items.mjs && prettier --write src/shared/planner-item-art.json",
    "sync:cube": "node scripts/sync-cube.mjs && prettier --write src/shared/cube-catalog.json",
    "sync:planner-affixes": "node scripts/sync-planner-affixes.mjs && prettier --write src/shared/planner-affixes.json"
  },
  "dependencies": {
    "@d2runewizard/d2s": "2.0.134",
    "d2r-saver": "0.2.0",
    "gh-pages": "^6.2.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^17.4.0",
    "postcss": "^8.4.49",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "stylelint": "^16.14.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^6.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.10"
  }
}
